# ─────────────────────────────────────────────────────────────
# Eco — environment template.  Copy to `.env` and fill in.
# Never commit a real .env.  Secrets belong in your secret
# manager (AWS Secrets Manager / GCP Secret Manager / Vault).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=UTC

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=eco
POSTGRES_PASSWORD=eco_dev_password_change_me
POSTGRES_DB=eco
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eco:eco_dev_password_change_me@localhost:5432/eco?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=900          # 15 minutes, in seconds
JWT_REFRESH_TTL=2592000     # 30 days, in seconds
JWT_ISSUER=eco.app
JWT_AUDIENCE=eco.clients

# ── Field-level encryption (AES-256-GCM) ────────────────────
# 32 bytes, base64.  Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_32_byte_base64_key
ENCRYPTION_KEY_VERSION=1

# ── OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/apple/callback

# ── Mail (SMTP; MailHog in local compose) ───────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Eco <no-reply@eco.app>"

# ── 2FA ─────────────────────────────────────────────────────
TOTP_ISSUER=Eco

# ── AI service ──────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace_me_shared_service_token

# ── Ollama / LLM ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Any small local model: llama3.2:3b | mistral:7b | phi3.5 | deepseek-r1:1.5b
ECO_LLM_MODEL=llama3.2:3b
ECO_LLM_TEMPERATURE=0.2
ECO_LLM_TIMEOUT_SECONDS=60
ECO_LLM_MAX_TOKENS=800

# ── Exchange rates ──────────────────────────────────────────
FX_PROVIDER=ecb              # ecb | openexchangerates | fixed
OPENEXCHANGERATES_APP_ID=
FX_REFRESH_CRON="0 5 * * *"
BASE_CURRENCY=USD

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Eco
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── Observability ───────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── Rate limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
