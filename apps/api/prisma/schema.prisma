// ═══════════════════════════════════════════════════════════════════════════
//  Eco — PostgreSQL schema
//
//  Conventions applied throughout:
//
//  • Money is BIGINT minor units (cents/fils) plus an ISO-4217 code. Never
//    FLOAT, never NUMERIC-with-implicit-rounding. See packages/shared/money.ts.
//  • Every user-owned row carries `userId` and is indexed on (userId, <sort
//    key>). Every query in the API filters by userId — that predicate is the
//    tenant boundary, and Postgres Row-Level Security enforces it a second time
//    (see infra/postgres/rls.sql) so an ORM mistake cannot leak across accounts.
//  • Deletes are soft (`deletedAt`) on financial records. A user who deletes a
//    transaction is correcting a mistake; a user who deletes their account gets
//    a genuine hard purge via the GDPR erasure job.
//  • Timestamps are `timestamptz`, always UTC. The user's timezone is a display
//    concern stored on the profile.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, btree_gin, citext]
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  PREMIUM
  SUPPORT
  ADMIN
}

enum IncomeType {
  SALARY
  FREELANCE
  BUSINESS
  INVESTMENT
  RENTAL
  SIDE_HUSTLE
  OTHER
}

enum Frequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  CAR_LOAN
  MORTGAGE
  STUDENT_LOAN
  MEDICAL
  CUSTOM
}

enum PayoffStrategy {
  SNOWBALL
  AVALANCHE
  CUSTOM
}

enum GoalType {
  EMERGENCY_FUND
  VACATION
  CAR_PURCHASE
  HOME_DOWN_PAYMENT
  RETIREMENT
  EDUCATION
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

enum BudgetType {
  FIXED
  VARIABLE
  ROLLING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationType {
  BILL_DUE
  BUDGET_EXCEEDED
  BUDGET_WARNING
  DEBT_DUE
  SAVINGS_MILESTONE
  GOAL_ACHIEVED
  AI_INSIGHT
  SECURITY_ALERT
  SYSTEM
}

enum RecommendationKind {
  REDUCE_CATEGORY_SPEND
  MOVE_CASH_TO_SAVINGS
  REFINANCE_DEBT
  ADJUST_BUDGET
  BUILD_EMERGENCY_FUND
  CANCEL_SUBSCRIPTION
  INCREASE_DEBT_PAYMENT
  CASHFLOW_WARNING
}

enum RecommendationStatus {
  NEW
  SEEN
  ACCEPTED
  DISMISSED
}

enum ReportPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ExportFormat {
  PDF
  XLSX
  CSV
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

enum OAuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  EXPORT
  AI_QUERY
}

enum ChatRole {
  user
  assistant
  system
}

// ─── Identity ─────────────────────────────────────────────────────────────

model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique @db.Citext
  /// Argon2id hash. Null for accounts created purely through OAuth.
  passwordHash String?
  name     String   @db.VarChar(120)
  role     UserRole @default(USER)

  country  String? @db.Char(2)
  /// The user's base currency. Every cross-currency figure is normalised here.
  currency String  @default("USD") @db.Char(3)
  timezone String  @default("UTC") @db.VarChar(64)
  locale   String  @default("en-US") @db.VarChar(16)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  /// TOTP secret, encrypted at the application layer with AES-256-GCM.
  twoFactorSecret     String?
  twoFactorEnabled    Boolean @default(false)
  /// Argon2 hashes of single-use recovery codes.
  twoFactorRecoveryCodes String[] @default([])

  /// Free-form objectives (target savings rate, debt-free date, …).
  financialGoals Json?

  /// Set on password change / "log out everywhere" — invalidates every
  /// refresh token issued before this instant without a table scan.
  tokensValidFrom DateTime @default(now())

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  onboardingCompleted Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  incomeSources   IncomeSource[]
  categories      Category[]
  expenses        Expense[]
  debts           Debt[]
  savingsGoals    SavingsGoal[]
  budgets         Budget[]
  accounts        FinancialAccount[]
  notifications   Notification[]
  notificationPreference NotificationPreference?
  pushTokens      PushToken[]
  refreshTokens   RefreshToken[]
  verificationTokens VerificationToken[]
  oauthAccounts   OAuthAccount[]
  auditLogs       AuditLog[]
  reports         Report[]
  recommendations Recommendation[]
  conversations   AiConversation[]
  forecasts       ForecastSnapshot[]
  spendingPatterns SpendingPattern[]

  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  providerUserId String
  /// Provider tokens, encrypted at rest. Only stored when we need offline access.
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// One row per issued refresh token, so a stolen token can be revoked
/// individually and every active session is listable in the UI.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 of the token. The raw value only ever exists in the client.
  tokenHash String    @unique
  /// Links rotations together; reuse of a retired token in a family means the
  /// token was stolen, and the whole family is revoked on the spot.
  familyId  String    @db.Uuid
  userAgent String?   @db.VarChar(400)
  ipAddress String?   @db.Inet
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use tokens for email verification, password reset and 2FA challenges.
model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  purpose   String   @db.VarChar(40)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ─── Accounts & currency ──────────────────────────────────────────────────

/// A cash or asset account. Manual today; the same table receives balances
/// from Open Banking aggregators in Phase 4 (`externalId` / `providerId`).
model FinancialAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  name           String   @db.VarChar(120)
  /// CHECKING | SAVINGS | CASH | INVESTMENT | OTHER
  kind           String   @db.VarChar(24)
  currency       String   @db.Char(3)
  /// The balance as at `openingBalanceDate`. The live balance is this plus
  /// every assigned transaction since, computed on read rather than stored, so
  /// an edited or deleted transaction cannot leave the figure drifted.
  openingBalanceMinor BigInt @default(0)
  openingBalanceDate  DateTime @default(now()) @db.Date
  isPrimary      Boolean  @default(false)
  /// Reserved for bank aggregation; null while the account is manual.
  providerId     String?  @db.VarChar(60)
  externalId     String?  @db.VarChar(120)
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  receipts      IncomeReceipt[]
  contributions GoalContribution[]

  @@index([userId, deletedAt])
  @@unique([providerId, externalId])
  @@map("financial_accounts")
}

/// Daily FX rates against a single base (USD). Storing one base and deriving
/// cross-rates keeps the table small and every conversion consistent.
model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  /// Units of `quote` per one unit of `base`.
  rate      Decimal  @db.Decimal(20, 10)
  date      DateTime @db.Date
  provider  String   @db.VarChar(40)
  fetchedAt DateTime @default(now())

  @@unique([base, quote, date])
  @@index([date])
  @@map("exchange_rates")
}

// ─── Income ───────────────────────────────────────────────────────────────

model IncomeSource {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  name        String     @db.VarChar(120)
  type        IncomeType
  amountMinor BigInt
  currency    String     @db.Char(3)
  frequency   Frequency
  startDate   DateTime   @db.Date
  endDate     DateTime?  @db.Date
  isActive    Boolean    @default(true)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts IncomeReceipt[]

  @@index([userId, isActive, deletedAt])
  @@index([userId, startDate])
  @@map("income_sources")
}

/// An actual payment landing, as opposed to the schedule it was expected on.
/// Keeping the two apart is what lets us tell "paid late" from "not paid".
model IncomeReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  /// Null for a one-off payment that has no recurring schedule behind it.
  incomeSourceId String?  @db.Uuid
  accountId      String?  @db.Uuid
  /// Set for a standalone receipt; otherwise copied from the source.
  name           String?  @db.VarChar(120)
  amountMinor    BigInt
  currency       String   @db.Char(3)
  /// Amount converted to the user's base currency at the receipt-date rate.
  baseAmountMinor BigInt
  date           DateTime @db.Date
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  incomeSource IncomeSource?     @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  account      FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId, date])
  @@index([incomeSourceId, date])
  @@map("income_receipts")
}

// ─── Categories & expenses ────────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  name     String  @db.VarChar(80)
  /// Stable identifier for the twelve seeded categories. Survives a rename, so
  /// the AI layer can still reason about "food" after the user calls it
  /// "Groceries & eating out". Null for user-created categories.
  slug     String? @db.VarChar(40)
  icon     String  @default("circle") @db.VarChar(40)
  color    String  @default("#64748b") @db.Char(7)
  parentId String? @db.Uuid

  /// True for seeded categories; they cannot be deleted, only archived.
  isSystem   Boolean @default(false)
  isArchived Boolean @default(false)
  /// Whether spend here counts toward the emergency-fund calculation.
  isEssential Boolean @default(false)

  monthlyBudgetMinor BigInt?
  sortOrder          Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("CategoryTree")
  expenses Expense[]
  budgetLines BudgetLine[]

  @@unique([userId, name])
  @@index([userId, isArchived])
  @@index([parentId])
  @@map("categories")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  categoryId  String   @db.Uuid
  accountId   String?  @db.Uuid
  amountMinor BigInt
  currency    String   @db.Char(3)
  /// Amount in the user's base currency, frozen at the transaction-date rate.
  /// Denormalised deliberately: every dashboard aggregate sums this column, and
  /// re-converting millions of rows per request is not viable.
  baseAmountMinor BigInt
  date        DateTime @db.Date
  merchant    String?  @db.VarChar(160)
  notes       String?  @db.Text

  isRecurring        Boolean    @default(false)
  recurringFrequency Frequency?
  /// Set when the row was generated from a detected recurring pattern.
  recurringGroupId   String?    @db.Uuid

  tags String[] @default([])

  /// Reserved for OCR receipt capture (Phase 4).
  receiptUrl String? @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Removing an account must not delete the spending that went through it.
  account  FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // The workhorse index: every list, chart and report filters by user and date.
  @@index([userId, date(sort: Desc), deletedAt])
  @@index([userId, categoryId, date])
  @@index([userId, merchant])
  @@index([accountId, date])
  @@index([recurringGroupId])
  @@map("expenses")
}

// ─── Debts ────────────────────────────────────────────────────────────────

model Debt {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  name                String   @db.VarChar(120)
  type                DebtType
  lender              String?  @db.VarChar(160)
  principalMinor      BigInt
  currentBalanceMinor BigInt
  /// Nominal APR as a percentage, e.g. 21.99.
  interestRateApr     Decimal  @db.Decimal(6, 3)
  minimumPaymentMinor BigInt
  currency            String   @db.Char(3)
  dueDayOfMonth       Int      @db.SmallInt
  openedDate          DateTime? @db.Date
  isClosed            Boolean  @default(false)
  closedAt            DateTime?
  notes               String?  @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, isClosed, deletedAt])
  @@index([userId, dueDayOfMonth])
  @@map("debts")
}

model DebtPayment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  debtId         String   @db.Uuid
  amountMinor    BigInt
  /// The split is recorded, not recomputed — a lender's actual allocation can
  /// differ from our model, and the ledger should reflect what happened.
  principalMinor BigInt
  interestMinor  BigInt
  currency       String   @db.Char(3)
  date           DateTime @db.Date
  /// Balance immediately after this payment, for an audit trail that does not
  /// require replaying the whole payment history.
  balanceAfterMinor BigInt
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([debtId, date(sort: Desc)])
  @@map("debt_payments")
}

/// A saved payoff plan. The schedule is recomputed on read (it is cheap and
/// always current); only the user's chosen inputs are persisted.
model PayoffPlan {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @db.Uuid
  strategy           PayoffStrategy
  monthlyBudgetMinor BigInt
  extraOneOffMinor   BigInt         @default(0)
  debtOrder          String[]       @default([])
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, isActive])
  @@map("payoff_plans")
}

// ─── Savings goals ────────────────────────────────────────────────────────

model SavingsGoal {
  id                       String     @id @default(uuid()) @db.Uuid
  userId                   String     @db.Uuid
  name                     String     @db.VarChar(120)
  type                     GoalType
  status                   GoalStatus @default(ACTIVE)
  targetAmountMinor        BigInt
  currentAmountMinor       BigInt     @default(0)
  currency                 String     @db.Char(3)
  deadline                 DateTime?  @db.Date
  monthlyContributionMinor BigInt?
  color                    String     @default("#0ea5e9") @db.Char(7)
  icon                     String     @default("piggy-bank") @db.VarChar(40)
  notes                    String?    @db.Text
  achievedAt               DateTime?
  /// Highest milestone (25/50/75/100) already notified, so a balance that
  /// oscillates around a threshold cannot spam the user.
  lastMilestoneNotified    Int        @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status, deletedAt])
  @@map("savings_goals")
}

model GoalContribution {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  /// The account the money came out of. Null records the saving without
  /// moving any balance, which leaves it counted in two places.
  accountId String? @db.Uuid
  goalId      String   @db.Uuid
  /// Signed: a withdrawal from the goal is a negative contribution.
  /// Denominated in `currency` — what the user actually typed.
  amountMinor BigInt
  currency    String   @db.Char(3)
  /// The same contribution converted into the goal's currency at the rate on
  /// `date`, then frozen. The goal's running balance is the sum of these, so
  /// paying into a USD goal in SAR cannot restate the balance every time the
  /// riyal moves — the same reason expenses freeze baseAmountMinor.
  goalAmountMinor BigInt
  date            DateTime @db.Date
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  goal    SavingsGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([goalId, date(sort: Desc)])
  @@index([userId, date])
  @@index([accountId, date])
  @@map("goal_contributions")
}

// ─── Budgets ──────────────────────────────────────────────────────────────

model Budget {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  /// First day of the budgeted month; the unique key is (userId, month).
  month             DateTime   @db.Date
  type              BudgetType @default(FIXED)
  currency          String     @db.Char(3)
  totalLimitMinor   BigInt?
  alertThresholdPct Int        @default(80)
  notes             String?    @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines BudgetLine[]

  @@unique([userId, month])
  @@index([userId, month(sort: Desc)])
  @@map("budgets")
}

model BudgetLine {
  id         String  @id @default(uuid()) @db.Uuid
  budgetId   String  @db.Uuid
  categoryId String  @db.Uuid
  limitMinor BigInt
  rollover   Boolean @default(false)
  /// Unspent room carried in from last month, computed at month rollover.
  rolloverFromPreviousMinor BigInt @default(0)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
  @@map("budget_lines")
}

// ─── AI layer ─────────────────────────────────────────────────────────────

/// Cached output of the pattern-learning job. Recomputing recurring-expense
/// detection over a long history on every dashboard load would be wasteful;
/// the job runs nightly and on significant data change.
model SpendingPattern {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// Full SpendingPatternDto payload.
  payload    Json
  /// Number of transactions the analysis was computed from, so we can tell
  /// whether the cache is worth invalidating.
  sampleSize Int
  computedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([expiresAt])
  @@map("spending_patterns")
}

/// A forecast run, retained so we can measure our own accuracy: once the month
/// arrives we compare `payload` against reality and track the error over time.
model ForecastSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  horizonMonths Int
  model         String   @db.VarChar(60)
  confidence    Decimal  @db.Decimal(4, 3)
  payload       Json
  /// Populated by the accuracy job once the forecast period has elapsed.
  realisedError Decimal? @db.Decimal(10, 4)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("forecast_snapshots")
}

model Recommendation {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  kind                 RecommendationKind
  status               RecommendationStatus @default(NEW)
  title                String               @db.VarChar(200)
  body                 String               @db.Text
  estimatedImpactMinor BigInt?
  currency             String               @db.Char(3)
  priority             String               @db.VarChar(10)
  /// The numeric inputs the advice was derived from, shown in the UI so no
  /// recommendation is ever an unexplained assertion.
  evidence             Json
  actionUrl            String?              @db.VarChar(200)
  /// Deduplicates: the same finding regenerated nightly updates in place
  /// rather than stacking up.
  fingerprint          String               @db.VarChar(80)
  dismissedAt          DateTime?
  createdAt            DateTime             @default(now())
  expiresAt            DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status, priority])
  @@index([expiresAt])
  @@map("recommendations")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           ChatRole
  content        String   @db.Text
  /// Which data-access tools the assistant invoked, and with what arguments.
  /// Retained for audit: every AI answer must be traceable to the queries
  /// behind it.
  toolCalls      Json?
  model          String?  @db.VarChar(60)
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(200)
  body      String              @db.Text
  actionUrl String?             @db.VarChar(200)
  metadata  Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  /// Stops a nightly job re-sending the same alert; unique per user.
  dedupeKey String?             @db.VarChar(120)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  channels          NotificationChannel[] @default([IN_APP, EMAIL])
  billDueLeadDays   Int      @default(3)
  budgetWarnings    Boolean  @default(true)
  debtReminders     Boolean  @default(true)
  savingsMilestones Boolean  @default(true)
  aiInsights        Boolean  @default(true)
  /// Local times in the user's timezone; nothing is pushed between them.
  quietHoursStart   String?  @db.VarChar(5)
  quietHoursEnd     String?  @db.VarChar(5)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  deviceName String?        @db.VarChar(120)
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Reports ──────────────────────────────────────────────────────────────

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  period      ReportPeriod
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  format      ExportFormat
  status      ReportStatus @default(PENDING)
  /// Object-storage key, not a public URL. Downloads are served through a
  /// short-lived signed URL minted per request.
  storageKey  String?      @db.VarChar(400)
  sizeBytes   Int?
  error       String?      @db.Text
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  /// Generated reports contain a full financial picture, so they self-destruct.
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("reports")
}

// ─── Audit ────────────────────────────────────────────────────────────────

/// Append-only. No update or delete path exists in the application, and the
/// `eco_app` database role is granted INSERT and SELECT only (see rls.sql).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  entityType String      @db.VarChar(60)
  entityId   String?     @db.Uuid
  /// Field-level before/after for mutations. Never contains secrets — the
  /// serialiser redacts password, token and secret keys.
  changes    Json?
  ipAddress  String?     @db.Inet
  userAgent  String?     @db.VarChar(400)
  requestId  String?     @db.VarChar(60)
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
